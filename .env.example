# ─────────────────────────────────────────────────────────────────────────────
# ElectEd — Environment Variables Template
# Copy this file to .env.development and .env.production and fill in your values.
# NEVER commit real keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

# AI (Anthropic Claude API)
VITE_AI_API_URL=https://api.anthropic.com/v1
VITE_ANTHROPIC_API_KEY=

# Firebase — get from Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
